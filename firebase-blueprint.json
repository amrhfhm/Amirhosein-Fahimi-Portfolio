{
  "entities": {
    "Project": {
      "title": "Portfolio Project",
      "description": "A detailed portfolio project and its case study content following the new template.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroMockup": { "type": "string" },
        "roleResponsibilities": { "type": "string" },
        "outcome": { "type": "string" },
        "backgroundTitle": { "type": "string" },
        "backgroundText": { "type": "string" },
        "backgroundImage": { "type": "string" },
        "problemTitle": { "type": "string" },
        "problemText": { "type": "string" },
        "problemImages": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "approachSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "body": { "type": "string" },
              "image": { "type": "string" }
            }
          }
        },
        "impactStats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "takeawayTitle": { "type": "string" },
        "takeawayText": { "type": "string" },
        "status": { "type": "string", "enum": ["Published", "Draft"] },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category"]
    },
    "Testimonial": {
      "title": "Client Testimonial",
      "description": "Feedback from clients or colleagues.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "avatar": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "role", "text"]
    },
    "Settings": {
      "title": "Site Settings",
      "description": "Global SEO and site configuration.",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "keywords": { "type": "string" },
        "ogImage": { "type": "string" }
      }
    },
    "AnalyticsEvent": {
      "title": "Analytics Event",
      "description": "Custom tracking events.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "projectId": { "type": "string" },
        "projectTitle": { "type": "string" },
        "page": { "type": "string" },
        "device": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["type", "device", "timestamp"]
    }
  },
  "firestore": {
    "projects": {
      "schema": "Project",
      "description": "Main portfolio projects and case studies."
    },
    "testimonials": {
      "schema": "Testimonial",
      "description": "User testimonials displayed on the site."
    },
    "settings": {
      "schema": "Settings",
      "description": "Global application configuration."
    },
    "analytics": {
      "schema": "AnalyticsEvent",
      "description": "Custom event tracking data."
    }
  }
}
