---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
---
<footer class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="eyebrow label" data-reveal><Icon name="lucide:send" aria-hidden="true" /> Contact</p>
    <h2 id="contact-title" data-reveal>Hiring for a product role?<br />Let's talk.</h2>
    <div class="links" data-reveal>
      <a class="btn btn-primary" href={`mailto:${site.email}`}><Icon name="lucide:mail" aria-hidden="true" /> {site.email}</a>
      <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener"><Icon name="lucide:linkedin" aria-hidden="true" /> LinkedIn</a>
      <a class="btn btn-ghost" href={site.resume} target="_blank" rel="noopener"><Icon name="lucide:file-text" aria-hidden="true" /> Resume</a>
    </div>
    <div class="bottom">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href="#top" class="top-link">Back to top <Icon name="lucide:arrow-up" aria-hidden="true" /></a>
    </div>
  </div>
</footer>

<style>
  .contact { border-top: 1px solid var(--border); padding-bottom: 40px; }
  .label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px; color: var(--accent-text); }
  .label [data-icon] { width: 15px; height: 15px; }
  h2 { margin: 0; font-size: clamp(36px, 5vw, 64px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 600; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .btn [data-icon] { width: 17px; height: 17px; }
  .btn-primary { background: var(--text); color: var(--bg); }
  .btn-ghost { border: 1px solid var(--border); }
  .btn-ghost:hover { background: var(--surface); opacity: 1; }
  .bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 96px; font-size: 14px; color: var(--muted); }
  .top-link { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; min-height: 44px; }
  .top-link [data-icon] { width: 15px; height: 15px; }
  .top-link:hover { color: var(--text); }
</style>
