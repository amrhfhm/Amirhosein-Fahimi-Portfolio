---
import { Icon } from 'astro-icon/components';
import { projects } from '../data/projects';
const featured = projects.find((p) => p.featured)!;
const rest = projects.filter((p) => !p.featured);
---
<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow kicker"><Icon name="lucide:layers" aria-hidden="true" /> Selected work</p>
      <h2 class="section-title" id="projects-title">Projects</h2>
    </div>

    <article class="featured" data-reveal data-spotlight>
      <div class="featured-head">
        <div>
          <p class="eyebrow meta"><Icon name="lucide:star" aria-hidden="true" /> Featured · {featured.org} · {featured.year}</p>
          <h3>{featured.title}</h3>
          <p class="summary">{featured.summary}</p>
        </div>
        <a class="btn btn-primary" href={`/work/${featured.slug}`}>
          Open case study
          <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
        </a>
      </div>
      <div class="screens">
        {featured.decisions?.map((d, i) => (
          <figure class="screen" data-reveal style={`transition-delay:${i * 90}ms`}>
            <div class="screen-img" role="img" aria-label="Screen to come">
              <Icon name="lucide:smartphone" aria-hidden="true" />
              <span>Screen {i + 1}</span>
            </div>
            <figcaption>
              <span class="num">0{i + 1}</span>
              <span>{d}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </article>

    <div class="grid">
      {rest.map((p, i) => (
        <div data-reveal style={`transition-delay:${(i % 2) * 90}ms`}><a class="card" href={`/work/${p.slug}`}>
          <div class="cover">
            {p.cover
              ? <img src={p.cover} alt="" loading="lazy" decoding="async" width="1400" height="875" />
              : <span class="cover-empty"><Icon name="lucide:image" aria-hidden="true" /> Cover to come</span>}
          </div>
          <div class="card-body">
            <div>
              <p class="eyebrow meta">{p.org} · {p.year}</p>
              <h3>{p.title}</h3>
              <p class="tag">{p.tag}</p>
            </div>
            <span class="go" aria-hidden="true"><Icon name="lucide:arrow-up-right" /></span>
          </div>
        </a></div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: flex; flex-direction: column; }
  .kicker { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 12px; color: var(--muted); }
  .kicker [data-icon] { width: 15px; height: 15px; }
  .meta { display: inline-flex; align-items: center; gap: 6px; margin: 0 0 12px; color: var(--accent-text); }
  .meta [data-icon] { width: 14px; height: 14px; }

  .featured {
    position: relative; overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 28px;
    padding: clamp(24px, 3.5vw, 44px);
  }
  .featured::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(520px circle at var(--mx, 70%) var(--my, 0%), color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%);
    opacity: 0; transition: opacity .4s ease;
  }
  .featured:hover::before { opacity: 1; }
  .featured > * { position: relative; }
  .featured-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .featured h3 { margin: 0; font-size: clamp(26px, 3vw, 36px); line-height: 1.12; letter-spacing: -0.025em; font-weight: 600; max-width: 680px; }
  .summary { margin: 14px 0 0; color: var(--muted); max-width: 620px; }
  .btn [data-icon] { width: 17px; height: 17px; }
  .btn-primary { background: var(--text); color: var(--bg); }
  .btn-primary .arrow { transition: transform .25s ease; }
  .btn-primary:hover .arrow { transform: translateX(3px); }

  .screens { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 40px; }
  .screen { margin: 0; }
  .screen-img {
    aspect-ratio: 9 / 17; border-radius: var(--radius-screen);
    background: var(--placeholder); border: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 8px; align-items: center; justify-content: center;
    color: var(--muted); font-size: 13px;
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
  }
  .screen-img [data-icon] { width: 22px; height: 22px; }
  .screen:hover .screen-img { transform: translateY(-4px); }
  figcaption { display: flex; gap: 10px; margin-top: 16px; font-size: 15px; line-height: 1.5; }
  .num {
    flex: none; height: 24px; padding: 0 8px; border-radius: 7px;
    background: var(--accent-soft); color: var(--accent-text);
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    display: inline-flex; align-items: center;
  }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .card {
    height: 100%;
    display: block; text-decoration: none;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 24px; padding: 14px;
    transition: border-color .25s ease, transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .card:hover { border-color: color-mix(in srgb, var(--text) 25%, transparent); transform: translateY(-3px); }
  .cover {
    aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden;
    background: var(--placeholder);
    display: flex; align-items: center; justify-content: center;
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .card:hover .cover img { transform: scale(1.035); }
  .cover-empty { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
  .cover-empty [data-icon] { width: 18px; height: 18px; }
  .card-body { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 20px 8px 8px; }
  .card h3 { margin: 0; font-size: 20px; line-height: 1.3; letter-spacing: -0.015em; font-weight: 600; }
  .tag { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
  .go {
    flex: none; width: 40px; height: 40px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--border);
    transition: background-color .25s ease, color .25s ease, transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .go [data-icon] { width: 18px; height: 18px; }
  .card:hover .go { background: var(--text); color: var(--bg); transform: rotate(45deg); }

  @media (max-width: 860px) {
    .screens { grid-template-columns: 1fr; }
    .screen-img { aspect-ratio: 4 / 3; }
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
