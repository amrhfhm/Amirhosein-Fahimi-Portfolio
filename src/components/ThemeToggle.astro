---
import { Icon } from 'astro-icon/components';
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle light and dark mode">
  <Icon name="lucide:sun" class="i sun" aria-hidden="true" />
  <Icon name="lucide:moon" class="i moon" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    position: relative;
    width: 40px; height: 40px;
    border-radius: 999px;
    border: 0;
    background: var(--glass-hover);
    color: var(--glass-text);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
    overflow: hidden;
  }
  .i {
    position: absolute; width: 18px; height: 18px;
    transition: transform .5s cubic-bezier(.2,.8,.2,1), opacity .3s ease;
  }
  :global([data-theme='dark']) .moon { transform: translateY(24px) rotate(-90deg); opacity: 0; }
  :global([data-theme='light']) .sun { transform: translateY(-24px) rotate(90deg); opacity: 0; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  });
</script>
