---
import { Icon } from 'astro-icon/components';
import { site, stats } from '../data/site';
---
<header class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="hero-body container">
    <p class="availability" data-reveal>
      <span class="dot" aria-hidden="true"></span>
      {site.availability}
    </p>
    <p class="eyebrow role" data-reveal>Senior product designer · Fintech</p>
    <h1 data-reveal>Complex rules,<br />simple products.</h1>
    <p class="lede" data-reveal>
      I design where banks, regulation and money set the rules. I frame the problem, make the call, and show what we traded away.
    </p>
    <div class="ctas" data-reveal>
      <a class="btn btn-primary" href="/work/xpay-money-movement">
        See featured case study
        <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
      </a>
      <a class="btn btn-ghost" href={site.resume} target="_blank" rel="noopener">
        <Icon name="lucide:file-text" aria-hidden="true" />
        Resume
      </a>
    </div>
  </div>

  <div class="stats container">
    {stats.map((s, i) => (
      <div data-reveal style={`transition-delay:${i * 70}ms`}><a class="stat" href={s.href}>
        <span class="stat-value">{s.value}</span>
        <span class="stat-label">{s.label}</span>
        <span class="stat-source">{s.source} <Icon name="lucide:arrow-up-right" aria-hidden="true" /></span>
      </a></div>
    ))}
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100svh, 960px);
    display: flex;
    flex-direction: column;
    background: #0C0C0D;
    color: #EDEDEB;
    padding-top: 96px;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgba(12,12,13,.96) 0%, rgba(12,12,13,.84) 45%, rgba(12,12,13,.35) 100%),
      linear-gradient(180deg, rgba(12,12,13,0) 55%, #0C0C0D 100%),
      radial-gradient(900px 520px at 82% 28%, rgba(255,122,77,.16) 0%, rgba(12,12,13,0) 60%),
      radial-gradient(1200px 700px at 85% 30%, #24242A 0%, #0C0C0D 70%);
  }

  .hero-body { padding-top: clamp(32px, 7vh, 80px); }
  .hero-body > * { max-width: 780px; }
  .availability {
    display: inline-flex; align-items: center; gap: 10px;
    margin: 0;
    min-height: 34px; padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.06);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    font-size: 13px; color: #D6D6D1;
  }
  .dot { position: relative; width: 8px; height: 8px; border-radius: 999px; background: #3DD68C; }
  .dot::after {
    content: ''; position: absolute; inset: -4px; border-radius: 999px;
    border: 2px solid #3DD68C; opacity: 0;
    animation: ping 2.4s cubic-bezier(0,0,.2,1) infinite;
  }
  @keyframes ping { 0% { transform: scale(.6); opacity: .7; } 80%, 100% { transform: scale(1.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .dot::after { animation: none; } }

  .role { margin: 32px 0 14px; color: #FF8F66; }
  h1 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(48px, 7vw, 86px);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .lede { margin: 28px 0 0; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: #C9C9C4; max-width: 600px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .btn [data-icon] { width: 17px; height: 17px; }
  .btn-primary { background: #EDEDEB; color: #0C0C0D; }
  .btn-primary .arrow { transition: transform .25s ease; }
  .btn-primary:hover .arrow { transform: translateX(3px); }
  .btn-ghost {
    color: #EDEDEB;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.05);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.1);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
  }

  .stats {
    margin-top: auto;
    padding-top: 64px;
    padding-bottom: 40px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .stat {
    height: 100%;
    display: flex; flex-direction: column; gap: 8px;
    padding: 22px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.045);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.1);
    -webkit-backdrop-filter: blur(18px) saturate(150%); backdrop-filter: blur(18px) saturate(150%);
    text-decoration: none;
    transition: background-color .25s ease, border-color .25s ease, transform .25s ease;
  }
  .stat:hover { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.18); transform: translateY(-2px); }
  .stat-value { font-weight: 600; font-size: clamp(34px, 3.6vw, 46px); letter-spacing: -0.035em; line-height: 1; }
  .stat-label { font-size: 15px; color: #C9C9C4; }
  .stat-source { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 12px; color: #8A8A86; transition: color .2s; }
  .stat-source [data-icon] { width: 13px; height: 13px; }
  .stat:hover .stat-source { color: #FF8F66; }

  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
